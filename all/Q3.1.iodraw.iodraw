<mxfile host="www.iodraw.com" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/151.0.0.0 Safari/537.36 Edg/151.0.0.0" version="24.7.17">
  <diagram name="第 1 页" id="e4yRiOgV9osbkUf_Lmsj">
    <mxGraphModel dx="717" dy="679" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="O1ju-O2xqUf5AKu2T8ts-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="O1ju-O2xqUf5AKu2T8ts-1" target="O1ju-O2xqUf5AKu2T8ts-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="O1ju-O2xqUf5AKu2T8ts-1" value="&lt;div&gt;&amp;nbsp;输入：题面 ω=1.7152, c_z=10000, c_θ=1000 + 附件3 问题3 行&lt;/div&gt;&lt;div&gt;（a_z,a_θ,b_z,b_θ,f,L）+ 附件4 + P1 k_h + P5 派生(J_f,J_o,s₀,K_g)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="630" height="80" as="geometry" />
        </mxCell>
        <mxCell id="O1ju-O2xqUf5AKu2T8ts-2" value="&lt;div&gt;双块一阶解耦论证：直线 PTO 力沿中轴对铰点无力矩（r×F 沿轴叉积为零）+&amp;nbsp;&lt;/div&gt;&lt;div&gt;小角度一阶近似（振子滑动对惯量变化为二阶项）&lt;/div&gt;&lt;div&gt;升级触发器：max(|α|,|β|) &amp;gt; 0.1 rad → 完整几何模型&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="630" height="110" as="geometry" />
        </mxCell>
        <mxCell id="O1ju-O2xqUf5AKu2T8ts-4" value="&lt;div&gt;&amp;nbsp;垂荡块 (z_f, z_o) 2×2 线性系统&lt;/div&gt;&lt;div&gt;M_z q̈+C_z q̇+K_z q=[f cosωt,0]&lt;/div&gt;&lt;div&gt;C_z=[[b_z+c_z,−c_z],[−c_z,c_z]]&lt;/div&gt;&lt;div&gt;K_z=[[k_h+k_spr,−k_spr],[−k_spr,k_spr]]&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="290" height="120" as="geometry" />
        </mxCell>
        <mxCell id="O1ju-O2xqUf5AKu2T8ts-5" value="&lt;div&gt;纵摇块 (α, β) 2×2 线性系统&lt;/div&gt;&lt;div&gt;M_θ q̈+C_θ q̇+K_θ q=[L cosωt,0]&lt;/div&gt;&lt;div&gt;K_θ=[[K_α+k_θ,−k_θ], [−k_θ, k_θ−K_g]]（K_g 负刚度）&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="320" width="290" height="120" as="geometry" />
        </mxCell>
        <mxCell id="O1ju-O2xqUf5AKu2T8ts-7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.541;entryY=0.017;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="O1ju-O2xqUf5AKu2T8ts-2" target="O1ju-O2xqUf5AKu2T8ts-4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="O1ju-O2xqUf5AKu2T8ts-8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.459;entryY=-0.004;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="O1ju-O2xqUf5AKu2T8ts-2" target="O1ju-O2xqUf5AKu2T8ts-5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="O1ju-O2xqUf5AKu2T8ts-9" value="&lt;div&gt;求解（两块同管线）：&lt;/div&gt;&lt;div&gt;① 频域黄金：2×2 复阻抗 → P̄=½cω²|相对复幅值|²（精确稳态主值）&lt;/div&gt;&lt;div&gt;② 零初值 DOP853 40T（rtol 1e-9, max_step=T/200）→ 733 点导出&lt;/div&gt;&lt;div&gt;③ 相量初值核验（vs 解析稳态 1e-13）+ 独立 RK4 增广双解法（1e-6/1e-4）&lt;/div&gt;&lt;div&gt;④ 零初值稳态可达性：逐周期积分 ≤400 周期，双判据 1e-7（垂荡 97 周期 / 纵摇 197 周期收敛，vs 频域 1e-8）&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="520" width="630" height="150" as="geometry" />
        </mxCell>
        <mxCell id="O1ju-O2xqUf5AKu2T8ts-10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.229;entryY=0.003;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="O1ju-O2xqUf5AKu2T8ts-4" target="O1ju-O2xqUf5AKu2T8ts-9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="O1ju-O2xqUf5AKu2T8ts-11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.771;entryY=-0.007;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="O1ju-O2xqUf5AKu2T8ts-5" target="O1ju-O2xqUf5AKu2T8ts-9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="O1ju-O2xqUf5AKu2T8ts-14" value="&lt;div&gt;稳态口径：频域精确值为主值&lt;/div&gt;&lt;div&gt;P̄_z = 41.8416 W&amp;nbsp;&lt;/div&gt;&lt;div&gt;P̄_θ = 1.4675×10⁻³ W&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="720" width="290" height="80" as="geometry" />
        </mxCell>
        <mxCell id="O1ju-O2xqUf5AKu2T8ts-15" value="&lt;div&gt;&amp;nbsp;报告制：40T 窗口含慢模态拍频&lt;/div&gt;&lt;div&gt;&amp;nbsp;瞬态（+0.63%），窗口值仅作对照；&lt;/div&gt;&lt;div&gt;&amp;nbsp;纵摇慢模态 τ≈45 s 未完全周期化&amp;nbsp;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="720" width="290" height="80" as="geometry" />
        </mxCell>
