        <mxCell id="6k0IvzSpuanzTU72WrBW-9" value="&lt;div&gt;孕周与Y浓度正相关&lt;/div&gt;&lt;div&gt;&lt;div&gt;BMI与Y浓度负相关&lt;/div&gt;&lt;/div&gt;&lt;div&gt;年龄只有弱趋势，个体差异明显&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
