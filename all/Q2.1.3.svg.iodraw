<!DOCTYPE svg PUBLIC "-//W3C//DTD SVG 1.1//EN" "http://www.w3.org/Graphics/SVG/1.1/DTD/svg11.dtd">
<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" version="1.1" width="521px" height="1131px" viewBox="-0.5 -0.5 521 1131" content="&lt;mxfile host=&quot;www.iodraw.com&quot; agent=&quot;Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/151.0.0.0 Safari/537.36 Edg/151.0.0.0&quot; version=&quot;24.7.17&quot;&gt;&#10;  &lt;diagram name=&quot;第 1 页&quot; id=&quot;ms4JDJcImTrNK6C-N3tT&quot;&gt;&#10;    &lt;mxGraphModel dx=&quot;682&quot; dy=&quot;646&quot; grid=&quot;1&quot; gridSize=&quot;10&quot; guides=&quot;1&quot; tooltips=&quot;1&quot; connect=&quot;1&quot; arrows=&quot;1&quot; fold=&quot;1&quot; page=&quot;1&quot; pageScale=&quot;1&quot; pageWidth=&quot;827&quot; pageHeight=&quot;1169&quot; math=&quot;0&quot; shadow=&quot;0&quot;&gt;&#10;      &lt;root&gt;&#10;        &lt;mxCell id=&quot;0&quot; /&gt;&#10;        &lt;mxCell id=&quot;1&quot; parent=&quot;0&quot; /&gt;&#10;        &lt;mxCell id=&quot;JYbCVB8NJNtR27vUfzgu-24&quot; style=&quot;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;&quot; parent=&quot;1&quot; source=&quot;JYbCVB8NJNtR27vUfzgu-1&quot; target=&quot;JYbCVB8NJNtR27vUfzgu-3&quot; edge=&quot;1&quot;&gt;&#10;          &lt;mxGeometry relative=&quot;1&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;JYbCVB8NJNtR27vUfzgu-1&quot; value=&quot;输入：题面 ω=2.2143 + 附件3 问题2 行（a,b,F）+ 附件4 + P1 k_h&quot; style=&quot;rounded=0;whiteSpace=wrap;html=1;&quot; parent=&quot;1&quot; vertex=&quot;1&quot;&gt;&#10;          &lt;mxGeometry x=&quot;60&quot; y=&quot;30&quot; width=&quot;270&quot; height=&quot;50&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;JYbCVB8NJNtR27vUfzgu-3&quot; value=&quot;&amp;lt;div&amp;gt;建立两体垂荡运动方程（浮子 M_f + 振子 m_o，P2b 阻尼系数型）&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;F_d = c|v_rel|^α_p·v_rel，目标 P̄ = (1/T)∫c|v_rel|^(α_p+2)dt&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;稳态双判据（末两周期功率差 + 周回状态差 ≤ 1e-7）&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;lt;br&amp;gt;&amp;lt;/div&amp;gt;&quot; style=&quot;rounded=0;whiteSpace=wrap;html=1;&quot; parent=&quot;1&quot; vertex=&quot;1&quot;&gt;&#10;          &lt;mxGeometry x=&quot;60&quot; y=&quot;110&quot; width=&quot;270&quot; height=&quot;110&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;JYbCVB8NJNtR27vUfzgu-26&quot; style=&quot;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;&quot; parent=&quot;1&quot; source=&quot;JYbCVB8NJNtR27vUfzgu-4&quot; target=&quot;JYbCVB8NJNtR27vUfzgu-6&quot; edge=&quot;1&quot;&gt;&#10;          &lt;mxGeometry relative=&quot;1&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;JYbCVB8NJNtR27vUfzgu-4&quot; value=&quot;情形1：常量阻尼（α_p=0，线性）&quot; style=&quot;rounded=0;whiteSpace=wrap;html=1;&quot; parent=&quot;1&quot; vertex=&quot;1&quot;&gt;&#10;          &lt;mxGeometry x=&quot;60&quot; y=&quot;260&quot; width=&quot;120&quot; height=&quot;60&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;JYbCVB8NJNtR27vUfzgu-5&quot; value=&quot;情形2：幂次阻尼（α_p∈[0,1]）&quot; style=&quot;rounded=0;whiteSpace=wrap;html=1;&quot; parent=&quot;1&quot; vertex=&quot;1&quot;&gt;&#10;          &lt;mxGeometry x=&quot;210&quot; y=&quot;260&quot; width=&quot;120&quot; height=&quot;60&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;JYbCVB8NJNtR27vUfzgu-34&quot; style=&quot;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;&quot; parent=&quot;1&quot; source=&quot;JYbCVB8NJNtR27vUfzgu-6&quot; target=&quot;JYbCVB8NJNtR27vUfzgu-30&quot; edge=&quot;1&quot;&gt;&#10;          &lt;mxGeometry relative=&quot;1&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;JYbCVB8NJNtR27vUfzgu-6&quot; value=&quot;&amp;lt;div&amp;gt;频域精确解 P̄_fd(c)=½c·ω²|Z_o−Z_f|²&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;对数网格 200 点粗扫 → 单峰性检查&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;→ 端点复核(c=0, 1e5)&amp;amp;nbsp;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;amp;nbsp;→ minimize_scalar(xatol=1e-8) 精化&amp;lt;/div&amp;gt;&quot; style=&quot;rounded=0;whiteSpace=wrap;html=1;&quot; parent=&quot;1&quot; vertex=&quot;1&quot;&gt;&#10;          &lt;mxGeometry x=&quot;10&quot; y=&quot;350&quot; width=&quot;220&quot; height=&quot;100&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;JYbCVB8NJNtR27vUfzgu-7&quot; value=&quot;&amp;lt;div&amp;gt;打靶法：单周期映射 Newton 求周期不动点&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;F(x)=advance(x)−x=0（hybr, factor=0.1）&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;初值=延续终态或频域相量解（失败相量重试）&amp;lt;/div&amp;gt;&quot; style=&quot;rounded=0;whiteSpace=wrap;html=1;&quot; parent=&quot;1&quot; vertex=&quot;1&quot;&gt;&#10;          &lt;mxGeometry x=&quot;260&quot; y=&quot;350&quot; width=&quot;220&quot; height=&quot;100&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;JYbCVB8NJNtR27vUfzgu-12&quot; value=&quot;&amp;lt;div&amp;gt;输出：情形1 c*=37193.8, P=229.334 W&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;amp;nbsp; &amp;amp;nbsp; &amp;amp;nbsp; &amp;amp;nbsp; &amp;amp;nbsp; 情形2 c*=100000（边界, 约束最优）, α*≈0.416, P=229.994 W（增益 +0.287%）&amp;lt;/div&amp;gt;&quot; style=&quot;rounded=0;whiteSpace=wrap;html=1;&quot; parent=&quot;1&quot; vertex=&quot;1&quot;&gt;&#10;          &lt;mxGeometry x=&quot;40&quot; y=&quot;1090&quot; width=&quot;490&quot; height=&quot;70&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;JYbCVB8NJNtR27vUfzgu-15&quot; style=&quot;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.569;entryY=0.054;entryDx=0;entryDy=0;entryPerimeter=0;&quot; parent=&quot;1&quot; source=&quot;JYbCVB8NJNtR27vUfzgu-3&quot; target=&quot;JYbCVB8NJNtR27vUfzgu-4&quot; edge=&quot;1&quot;&gt;&#10;          &lt;mxGeometry relative=&quot;1&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;JYbCVB8NJNtR27vUfzgu-16&quot; style=&quot;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.437;entryY=0.026;entryDx=0;entryDy=0;entryPerimeter=0;&quot; parent=&quot;1&quot; source=&quot;JYbCVB8NJNtR27vUfzgu-3&quot; target=&quot;JYbCVB8NJNtR27vUfzgu-5&quot; edge=&quot;1&quot;&gt;&#10;          &lt;mxGeometry relative=&quot;1&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;JYbCVB8NJNtR27vUfzgu-27&quot; style=&quot;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.193;entryY=0.024;entryDx=0;entryDy=0;entryPerimeter=0;&quot; parent=&quot;1&quot; source=&quot;JYbCVB8NJNtR27vUfzgu-5&quot; target=&quot;JYbCVB8NJNtR27vUfzgu-7&quot; edge=&quot;1&quot;&gt;&#10;          &lt;mxGeometry relative=&quot;1&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;JYbCVB8NJNtR27vUfzgu-30&quot; value=&quot;&amp;lt;div&amp;gt;频域精确解 P̄_fd(c)=½c·ω²|Z_o−Z_f|²&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;对数网格 200 点粗扫 → 单峰性检查&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;→ 端点复核(c=0, 1e5)&amp;amp;nbsp;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;amp;nbsp;→ minimize_scalar(xatol=1e-8) 精化&amp;lt;/div&amp;gt;&quot; style=&quot;rounded=0;whiteSpace=wrap;html=1;&quot; parent=&quot;1&quot; vertex=&quot;1&quot;&gt;&#10;          &lt;mxGeometry x=&quot;10&quot; y=&quot;500&quot; width=&quot;220&quot; height=&quot;100&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id