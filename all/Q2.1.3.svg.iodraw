ght=&quot;60&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;bl2AAWoC4O9tvCsGjw7q-3&quot; style=&quot;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;&quot; edge=&quot;1&quot; parent=&quot;1&quot; source=&quot;JYbCVB8NJNtR27vUfzgu-33&quot; target=&quot;bl2AAWoC4O9tvCsGjw7q-1&quot;&gt;&#10;          &lt;mxGeometry relative=&quot;1&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;JYbCVB8NJNtR27vUfzgu-33&quot; value=&quot;&amp;lt;div&amp;gt;c=C_MAX 上边界一维精化（α∈[0.35,0.50]，xatol=1e-4）&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;+ 四角点显式比较→ 边界最优 c*=1e5, α*≈0.416&amp;lt;/div&amp;gt;&quot; style=&quot;rounded=0;whiteSpace=wrap;html=1;&quot; parent=&quot;1&quot; vertex=&quot;1&quot;&gt;&#10;          &lt;mxGeometry x=&quot;260&quot; y=&quot;790&quot; width=&quot;270&quot; height=&quot;60&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;JYbCVB8NJNtR27vUfzgu-35&quot; style=&quot;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.409;entryY=-0.02;entryDx=0;entryDy=0;entryPerimeter=0;&quot; parent=&quot;1&quot; source=&quot;JYbCVB8NJNtR27vUfzgu-7&quot; target=&quot;JYbCVB8NJNtR27vUfzgu-31&quot; edge=&quot;1&quot;&gt;&#10;          &lt;mxGeometry relative=&quot;1&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;JYbCVB8NJNtR27vUfzgu-39&quot; style=&quot;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.162;entryY=0.022;entryDx=0;entryDy=0;entryPerimeter=0;&quot; parent=&quot;1&quot; source=&quot;JYbCVB8NJNtR27vUfzgu-30&quot; target=&quot;JYbCVB8NJNtR27vUfzgu-12&quot; edge=&quot;1&quot;&gt;&#10;          &lt;mxGeometry relative=&quot;1&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;bl2AAWoC4O9tvCsGjw7q-4&quot; style=&quot;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;&quot; edge=&quot;1&quot; parent=&quot;1&quot; source=&quot;bl2AAWoC4O9tvCsGjw7q-1&quot; target=&quot;bl2AAWoC4O9tvCsGjw7q-2&quot;&gt;&#10;          &lt;mxGeometry relative=&quot;1&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;bl2AAWoC4O9tvCsGjw7q-1&quot; value=&quot;&amp;lt;div&amp;gt;α_p=0 端点退化验证&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;（时域 vs 频域 0.000%；插值 c*_row0 vs 情形1 c* 差 0.001%）&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;双解法抽查（RK4 vs DOP853，&amp;amp;lt;1e-4）&amp;lt;/div&amp;gt;&quot; style=&quot;rounded=0;whiteSpace=wrap;html=1;&quot; vertex=&quot;1&quot; parent=&quot;1&quot;&gt;&#10;          &lt;mxGeometry x=&quot;260&quot; y=&quot;890&quot; width=&quot;270&quot; height=&quot;60&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;bl2AAWoC4O9tvCsGjw7q-2&quot; value=&quot;&amp;lt;div&amp;gt;周期稳态五层证据链（最终最优/网格最优/α=0 退化三点，全部 5/5 通过）：&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;①打靶残差≤1e-7 ②相邻周期 ③扰动衰减④Floquet 谱半径&amp;amp;lt;1 ⑤多初值收敛同一响应&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;不主张唯一/全局吸引（Poincaré–Bendixson不适用）&amp;lt;/div&amp;gt;&quot; style=&quot;rounded=0;whiteSpace=wrap;html=1;&quot; vertex=&quot;1&quot; parent=&quot;1&quot;&gt;&#10;          &lt;mxGeometry x=&quot;260&quot; y=&quot;970&quot; width=&quot;270&quot; height=&quot;100&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;bl2AAWoC4O9tvCsGjw7q-5&quot; style=&quot;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.734;entryY=0.064;entryDx=0;entryDy=0;entryPerimeter=0;&quot; edge=&quot;1&quot; parent=&quot;1&quot; source=&quot;bl2AAWoC4O9tvCsGjw7q-2&quot; target=&quot;JYbCVB8NJNtR27vUfzgu-12&quot;&gt;&#10;          &lt;mxGeometry relative=&quot;1&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;      &lt;/root&gt;&#10;    &lt;/mxGraphModel&gt;&#10;  &lt;/diagram&gt;&#10;&lt;/mxfile&gt;&#10;"><defs/><g><g data-cell-id="0"><g data-cell-id="1"><g data-cell-id="JYbCVB8NJNtR27vUfzgu-24"><g><path d="M 185 50 L 185 70 L 185 60 L 185 73.63" fill="none" stroke="rgb(0, 0, 0)" stroke-miterlimit="10" pointer-events="stroke"/><path d="M 185 78.88 L 181.5 71.88 L 185 73.63 L 188.5 71.88 Z" fill="rgb(0, 0, 0)" stroke="rgb(0, 0, 0)" stroke-miterlimit="10" pointer-events="all"/></g></g><g data-cell-id="JYbCVB8NJNtR27vUfzgu-1"><g><rect x="50" y="0" width="270" height="50" fill="rgb(255, 255, 255)" stroke="rgb(0, 0, 0)" pointer-events="all"/></g><g><g transform="translate(-0.5 -0.5)"><switch><foreignObject pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; text-align: left;"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 268px; height: 1px; padding-top: 25px; margin-left: 51px;"><div data-drawio-colors="color: rgb(0, 0, 0); " style="box-sizing: border-box; font-size: 0px; text-align: center;"><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: rgb(0, 0, 0); line-height: 1.2; pointer-events: all; white-space: normal; overflow-wrap: normal;">输入：题面 ω=2.2143 + 附件3 问题2 行（a,b,F）+ 附件4 + P1 k_h</div></div></div></foreignObject><text x="185" y="29" fill="rgb(0, 0, 0)" font-family="&quot;Helvetica&quot;" font-size="12px" text-anchor="middle">输入：题面 ω=2.2143 + 附件3 问题2 行（a,b,F）+ 附件4 + P1 k_h</text></switch></g></g></g><g data-cell-id="JYbCVB8NJNtR27vUfzgu-3"><g><rect x="50" y="80" width="270" height="110" fill="rgb(255, 255, 255)" stroke="rgb(0, 0, 0)" pointer-events="all"/></g><g><g transform="translate(-0.5 -0.5)"><switch><foreignObject pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; text-align: left;"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 268px; height: 1px; padding-top: 135px; margin-left: 51px;"><div data-drawio-colors="color: rgb(0, 0, 0); " style="box-sizing: border-box; font-size: 0px; text-align: center;"><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: rgb(0, 0, 0); line-height: 1.2; pointer-events: all; white-space: normal; overflow-wrap: normal;"><div>建立两体垂荡运动方程（浮子 M_f + 振子 m_o，P2b 阻尼系数型）</div><div>F_d = c|v_rel|^α_p·v_rel，目标 P̄ = (1/T)∫c|v_rel|^(α_p+2)dt</div><div>稳态双判据（末两周期功率差 + 周回状态差 ≤ 1e-7）</div><div><br /></div></div></div></div></foreignObject><text x="185" y="139" fill="rgb(0, 0, 0)" font-family="&quot;Helvetica&quot;" font-size="12px" text-anchor="middle">建立两体垂荡运动方程（浮子 M_f + 振子 m_o，P2b 阻尼系数型）...</text></switch></g></g></g><g data-cell-id="JYbCVB8NJNtR27vUfzgu-26"><g><path d="M 110 290 L 110 313.63" fill="none" stroke="rgb(0, 0, 0)" stroke-miterlimit="10" pointer-events="stroke"/><path d="M 110 318.88 L 106.5 311.88 L 110 313.63 L 113.5 311.88 Z" fill="rgb(0, 0, 0)" stroke="rgb(0, 0, 0)" stroke-miterlimit="10" pointer-events="all"/></g></g><g data-cell-id="JYbCVB8NJNtR27vUfzgu-4"><g><rect x="50" y="230" width="120" height="60" fill="rgb(255, 255, 255)" stroke="rgb(0, 0, 0)" pointer-events="all"/></g><g><g transform="translate(-0.5 -0.5)"><switch><foreignObject pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; text-align: left;"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 118px; height: 1px; padding-top: 260px; margin-left: 51px;"><div data-drawio-colors="color: rgb(0, 0, 0); " style="box-sizing: border-box; font-size: 0px; text-align: center;"><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: rgb(0, 0, 0); line-height: 1.2; pointer-events: all; white-space: normal; overflow-wrap: normal;">情形1：常量阻尼（α_p=0，线性）</div></div></div></foreignObject><text x="110" y="264" fill="rgb(0, 0, 0)" font-family="&quot;Helvetica&quot;" font-size="12px" text-anchor="middle">情形1：常量阻尼（α_p=0，线性）</text></switch></g></g></g><g data-cell-id="JYbCVB8NJNtR27vUfzgu-5"><g><rect x="200" y="230" width="120" height="60" fill="rgb(255, 255, 255)" stroke="rgb(0, 0, 0)" pointer-events="all"/></g><g><g transform="translate(-0.5 -0.5)"><switch><foreignObject pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; text-align: left;"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 118px; height: 1px; padding-top: 260px; margin-left: 201px;"><div data-drawio-colors="color: rgb(0, 0, 0); " style="box-sizing: border-box; font-size: 0px; text-align: center;"><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: rgb(0, 0, 0); line-height: 1.2; pointer-events: all; white-space: normal; overflow-wrap: normal;">情形2：幂次阻尼（α_p∈[0,1]）</div></div></div></foreignObject><text x="260" y="264" fill="rgb(0, 0, 0)" font-family="&quot;Helvetica&quot;" font-size="12px" text-anchor="middle">情形2：幂次阻尼（α_p∈[0,1]）</text></switch></g></g></g><g data-cell-id="JYbCVB8NJNtR27vUfzgu-34"><g><path d="M 110 420 L 110 463.63" fill="none" stroke="rgb(0, 0, 0)" stroke-miterlimit="10" pointer-events="stroke"/><path d="M 110 468.88 L 106.5 461.88 L 110 463.63 L 113.5 461.88 Z" fill="rgb(0, 0, 0)" stroke="rgb(0, 0, 0)" stroke-miterlimit="10" pointer-events="all"/></g></g><g data-cell-id="JYbCVB8NJNtR27vUfzgu-6"><g><rect x="0" y="320" width="220" height="100" fill="rgb(255, 255, 255)" stroke="rgb(0, 0, 0)" pointer-events="all"/></g><g><g transform="translate(-0.5 -0.5)"><switch><foreignObject pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; text-align: left;"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 218px; height: 1px; padding-top: 370px; margin-left: 1px;"><div data-drawio-colors="color: rgb(0, 0, 0); " style="box-sizing: border-box; font-size: 0px; text-align: center;"><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: rgb(0, 0, 0); line-height: 1.2; pointer-events: all; white-space: normal; overflow-wrap: normal;"><div>频域精确解 P̄_fd(c)=½c·ω²|Z_o−Z_f|²</div><div>对数网格 200 点粗扫 → 单峰性检查</div><div>→ 端点复核(c=0, 1e5) </div><div> → minimize_scalar(xatol=1e-8) 精化</div></div></div></div></foreignObject><text x="110" y="374" fill="rgb(0, 0, 0)" font-family="&quot;Helvetica&quot;" font-size="12px" text-anchor="middle">频域精确解 P̄_fd(c)=½c·ω²|Z_o−Z_f|²...</text></switch></g></g></g><g data-cell-id="JYbCVB8NJNtR27vUfzgu-7"><g><rect x="250" y="320" width="220" height="100" fill="rgb(255, 255, 255)" stroke="rgb(0, 0, 0)" pointer-events="all"/></g><g><g transform="translate(-0.5 -0.5)"><switch><foreignObject pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; text-align: left;"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 218px; height: 1px; padding-top: 370px; margin-left: 251px;"><div data-drawio-colors="color: rgb(0, 0, 0); " style="box-sizing: border-box; font-size: 0px; text-align: center;"><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: rgb(0, 0, 0); line-height: 1.2; pointer-events: all; white-space: normal; overflow-wrap: normal;"><div>打靶法：单周期映射 Newton 求周期不动点</div><div>F(x)=advance(x)−x=0（hybr, factor=0.1）</div><div>初值=延续终态或频域相量解（失败相量重试）</div></div></div></div></foreignObject><text x="360" y="374" fill="rgb(0, 0, 0)" font-family="&quot;Helvetica&quot;" font-size="12px" text-anchor="middle">打靶法：单周期映射 Newton 求周期不动点...</text></switch></g></g></g><g data-cell-id="JYbCVB8NJNtR27vUfzgu-12"><g><rect x="30" y="1060" width="490" height="70" fill="rgb(255, 255, 255)" stroke="rgb(0, 0, 0)" pointer-events="all"/></g><g><g transform="translate(-0.5 -0.5)"><switch><foreignObject pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; text-align: left;"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 488px; height: 1px; padding-top: 1095px; margin-left: 31px;"><div data-drawio-colors="color: rgb(0, 0, 0); " style="box-sizing: border-box; font-size: 0px; text-align: center;"><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: rgb(0, 0, 0); line-height: 1.2; pointer-events: all; white-space: normal; overflow-wrap: normal;"><div>输出：情形1 c*=37193.8, P=229.334 W</div><div>          情形2 c*=100000（边界, 约束最优）, α*≈0.416, P=229.994 W（增益 +0.287%）</div></div></div></div></foreignObject><text x="275" y="1099" fill="rgb(0, 0, 0)" font-family="&quot;Helvetica&quot;" font-size="12px" text-anchor="middle">输出：情形1 c*=37193.8, P=229.334 W...</text></switch></g></g></g><g data-cell-id="JYbCVB8NJNtR27vUfzgu-15"><g><path d="M 117.5 190 L 117.5 210 L 118.07 226.88" fill="none" stroke="rgb(0, 0, 0)" stroke-miterlimit="10" pointer-events="stroke"/><path d="M 118.24 232.12 L 114.51 225.24 L 118.07 226.88 L 121.51 225.01 Z" fill="rgb(0, 0, 0)" stroke="rgb(0, 0, 0)" stroke-miterlimit="10" pointer-events="all"/></g></g><g data-cell-id="JYbCVB8NJNtR27vUfzgu-16"><g><path d="M 252.5 190 L 252.5 210 L 252.46 225.19" fill="none" stroke="rgb(0, 0, 0)" stroke-miterlimit="10" pointer-events="stroke"/><path d="M 252.44 230.44 L 248.96 223.43 L 252.46 225.19 L 255.96 223.45 Z" fill="rgb(0, 0, 0)" stroke="rgb(0, 0, 0)" stroke-miterlimit="10" pointer-events="all"/></g></g><g data-cell-id="JYbCVB8NJNtR27vUfzgu-27"><g><path d="M 290 290 L 292.5 290 L 292.47 316.03" fill="none" stroke="rgb(0, 0, 0)" stroke-miterlimit="10" pointer-events="stroke"/><path d="M 292.46 321.28 L 288.97 314.28 L 292.47 316.03 L 295.97 314.29 Z" fill="rgb(0, 0, 0)" stroke="rgb(0, 0, 0)" stroke-miterlimit="10" pointer-events="all"/></g></g><g data-cell-id="JYbCVB8NJNtR27vUfzgu-30"><g><rect x="0" y="470" width="220" height="100" fill="rgb(255, 255, 255)" stroke="rgb(0, 0, 0)" pointer-events="all"/></g><g><g transform="translate(-0.5 -0.5)"><switch><foreignObject pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; text-align: left;"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 218px; height: 1px; padding-top: 520px; margin-left: 1px;"><div data-drawio-colors="color: rgb(0, 0, 0); " style="box-sizing: border-box; font-size: 0px; text-align: center;"><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: rgb(0, 0, 0); line-height: 1.2; pointer-events: all; white-space: normal; overflow-wrap: normal;"><div>频域精确解 P̄_fd(c)=½c·ω²|Z_o−Z_f|²</div><div>对数网格 200 点粗扫 → 单峰性检查</div><div>→ 端点复核(c=0, 1e5) </div><div> → minimize_scalar(xatol=1e-8) 精化</div></div></div></div></foreignObject><text x="110" y="524" fill="rgb(0, 0, 0)" font-family="&quot;Helvetica&quot;" font-size="12px" text-anchor="middle">频域精确解 P̄_fd(c)=½c·ω²|Z_o−Z_f|²...</text></switch></g></g></g><g data-cell-id="JYbCVB8NJNtR27vUfzgu-36"><g><path d="M 385 570 L 385 633.63" fill="none" stroke="rgb(0, 0, 0)" stroke-miterlimit="10" pointer-events="stroke"/><path d="M 385 638.88 L 381.5 631.88 L 385 633.63 L 388.5 631.88 Z" fill="rgb(0, 0, 0)" stroke="rgb(0, 0, 0)" stroke-miterlimit="10" pointer-events="all"/></g></g><g data-cell-id="JYbCVB8NJNtR27vUfzgu-31"><g><rect x="250" y="470" width="270" height="100" fill="rgb(255, 255, 255)" stroke="rgb(0, 0, 0)" pointer-events="all"/></g><g><g transform="translate(-0.5 -0.5)"><switch><foreignObject pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; text-align: left;"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 268px; height: 1px; padding-top: 520px; margin-left: 251px;"><div data-drawio-colors="color: rgb(0, 0, 0); " style="box-sizing: border-box; font-size: 0px; text-align: center;"><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: rgb(0, 0, 0); line-height: 1.2; pointer-events: all; white-space: normal; overflow-wrap: normal;"><div>二维网格粗扫：c 线性 2500 档(41) ×</div><div>α 0.05 档(21) = 861 点 + 参数延续（收敛终态作下一格点初值，只作打靶猜测）</div><div>每点 DOP853 增广状态功率积分，双判据 1e-7</div><div>连续 3 周期达标早停，末 10 周期平均</div></div></div></div></foreignObject><text x="385" y="524" fill="rgb(0, 0, 0)" font-family="&quot;Helvetica&quot;" font-size="12px" text-anchor="middle">二维网格粗扫：c 线性 2500 档(41) ×...</text></switch></g></g></g><g data-cell-id="JYbCVB8NJNtR27vUfzgu-37"><g><path d="M 385 700 L 385 753.63" fill="none" stroke="rgb(0, 0, 0)" stroke-miterlimit="10" pointer-events="stroke"/><path d="M 385 758.88 L 381.5 751.88 L 385 753.63 L 388.5 751.88 Z" fill="rgb(0, 0, 0)" stroke="rgb(0, 0, 0)" stroke-miterlimit="10" pointer-events="all"/></g></g><g data-cell-id="JYbCVB8NJNtR27vUfzgu-32"><g><rect x="250" y="640" width="270" height="60" fill="rgb(255, 255, 255)" stroke="rgb(0, 0, 0)" pointer-events="all"/></g><g><g transform="translate(-0.5 -0.5)"><switch><foreignObject pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; text-align: left;"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 268px; height: 1px; padding-top: 670px; margin-left: 251px;"><div data-drawio-colors="color: rgb(0, 0, 0); " style="box-sizing: border-box; font-size: 0px; text-align: center;"><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: rgb(0, 0, 0); line-height: 1.2; pointer-events: all; white-space: normal; overflow-wrap: normal;"><div>多起点 Powell 有界精化：top-5 收敛点，</div><div>归一化 u=c/C_MAX；xtol=1e-6/ftol=1e-9/ </div><div>maxfev=400；拒绝 success=False 中间点</div></div></div></div></foreignObject><text x="385" y="674" fill="rgb(0, 0, 0)" font-family="&quot;Helvetica&quot;" font-size="12px" text-anchor="middle">多起点 Powell 有界精化：top-5 收敛点，...</text></switch></g></g></g><g data-cell-id="bl2AAWoC4O9tvCsGjw7q-3"><g><path d="M 385 820 L 385 853.63" fill="none" stroke="rgb(0, 0, 0)" stroke-miterlimit="10" pointer-events="stroke"/><path d="M 385 858.88 L 381.5 851.88 L 385 853.63 L 388.5 851.88 Z" fill="rgb(0, 0, 0)" stroke="rgb(0, 0, 0)" stroke-miterlimit="10" pointer-events="all"/></g></g><g data-cell-id="JYbCVB8NJNtR27vUfzgu-33"><g><rect x="250" y="760" width="270" height="60" fill="rgb(255, 255, 255)" stroke="rgb(0, 0, 0)" pointer-events="all"/></g><g><g transform="translate(-0.5 -0.5)"><switch><foreignObject pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; text-align: left;"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 268px; height: 1px; padding-top: 790px; margin-left: 251px;"><div data-drawio-colors="color: rgb(0, 0, 0); " style="box-sizing: border-box; font-size: 0px; text-align: center;"><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: rgb(0, 0, 0); line-height: 1.2; pointer-events: all; white-space: normal; ov