<!DOCTYPE svg PUBLIC "-//W3C//DTD SVG 1.1//EN" "http://www.w3.org/Graphics/SVG/1.1/DTD/svg11.dtd">
<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" version="1.1" width="631px" height="1092px" viewBox="-0.5 -0.5 631 1092" content="&lt;mxfile host=&quot;www.iodraw.com&quot; agent=&quot;Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/151.0.0.0 Safari/537.36 Edg/151.0.0.0&quot; version=&quot;24.7.17&quot;&gt;&#10;  &lt;diagram name=&quot;第 1 页&quot; id=&quot;e4yRiOgV9osbkUf_Lmsj&quot;&gt;&#10;    &lt;mxGraphModel dx=&quot;717&quot; dy=&quot;679&quot; grid=&quot;1&quot; gridSize=&quot;10&quot; guides=&quot;1&quot; tooltips=&quot;1&quot; connect=&quot;1&quot; arrows=&quot;1&quot; fold=&quot;1&quot; page=&quot;1&quot; pageScale=&quot;1&quot; pageWidth=&quot;827&quot; pageHeight=&quot;1169&quot; math=&quot;0&quot; shadow=&quot;0&quot;&gt;&#10;      &lt;root&gt;&#10;        &lt;mxCell id=&quot;0&quot; /&gt;&#10;        &lt;mxCell id=&quot;1&quot; parent=&quot;0&quot; /&gt;&#10;        &lt;mxCell id=&quot;O1ju-O2xqUf5AKu2T8ts-3&quot; style=&quot;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;&quot; edge=&quot;1&quot; parent=&quot;1&quot; source=&quot;O1ju-O2xqUf5AKu2T8ts-1&quot; target=&quot;O1ju-O2xqUf5AKu2T8ts-2&quot;&gt;&#10;          &lt;mxGeometry relative=&quot;1&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;O1ju-O2xqUf5AKu2T8ts-1&quot; value=&quot;&amp;lt;div&amp;gt;&amp;amp;nbsp;输入：题面 ω=1.7152, c_z=10000, c_θ=1000 + 附件3 问题3 行&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;（a_z,a_θ,b_z,b_θ,f,L）+ 附件4 + P1 k_h + P5 派生(J_f,J_o,s₀,K_g)&amp;lt;/div&amp;gt;&quot; style=&quot;rounded=0;whiteSpace=wrap;html=1;&quot; vertex=&quot;1&quot; parent=&quot;1&quot;&gt;&#10;          &lt;mxGeometry x=&quot;40&quot; y=&quot;30&quot; width=&quot;630&quot; height=&quot;80&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;O1ju-O2xqUf5AKu2T8ts-2&quot; value=&quot;&amp;lt;div&amp;gt;双块一阶解耦论证：直线 PTO 力沿中轴对铰点无力矩（r×F 沿轴叉积为零）+&amp;amp;nbsp;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;小角度一阶近似（振子滑动对惯量变化为二阶项）&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;升级触发器：max(|α|,|β|) &amp;amp;gt; 0.1 rad → 完整几何模型&amp;lt;/div&amp;gt;&quot; style=&quot;rounded=0;whiteSpace=wrap;html=1;&quot; vertex=&quot;1&quot; parent=&quot;1&quot;&gt;&#10;          &lt;mxGeometry x=&quot;40&quot; y=&quot;160&quot; width=&quot;630&quot; height=&quot;110&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;O1ju-O2xqUf5AKu2T8ts-4&quot; value=&quot;&amp;lt;div&amp;gt;&amp;amp;nbsp;垂荡块 (z_f, z_o) 2×2 线性系统&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;M_z q̈+C_z q̇+K_z q=[f cosωt,0]&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;C_z=[[b_z+c_z,−c_z],[−c_z,c_z]]&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;K_z=[[k_h+k_spr,−k_spr],[−k_spr,k_spr]]&amp;lt;/div&amp;gt;&quot; style=&quot;rounded=0;whiteSpace=wrap;html=1;&quot; vertex=&quot;1&quot; parent=&quot;1&quot;&gt;&#10;          &lt;mxGeometry x=&quot;40&quot; y=&quot;320&quot; width=&quot;290&quot; height=&quot;120&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;O1ju-O2xqUf5AKu2T8ts-5&quot; value=&quot;&amp;lt;div&amp;gt;纵摇块 (α, β) 2×2 线性系统&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;M_θ q̈+C_θ q̇+K_θ q=[L cosωt,0]&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;K_θ=[[K_α+k_θ,−k_θ], [−k_θ, k_θ−K_g]]（K_g 负刚度）&amp;lt;/div&amp;gt;&quot; style=&quot;rounded=0;whiteSpace=wrap;html=1;&quot; vertex=&quot;1&quot; parent=&quot;1&quot;&gt;&#10;          &lt;mxGeometry x=&quot;380&quot; y=&quot;320&quot; width=&quot;290&quot; height=&quot;120&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;O1ju-O2xqUf5AKu2T8ts-7&quot; style=&quot;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.541;entryY=0.017;entryDx=0;entryDy=0;entryPerimeter=0;&quot; edge=&quot;1&quot; parent=&quot;1&quot; source=&quot;O1ju-O2xqUf5AKu2T8ts-2&quot; target=&quot;O1ju-O2xqUf5AKu2T8ts-4&quot;&gt;&#10;          &lt;mxGeometry relative=&quot;1&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;O1ju-O2xqUf5AKu2T8ts-8&quot; style=&quot;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.459;entryY=-0.004;entryDx=0;entryDy=0;entryPerimeter=0;&quot; edge=&quot;1&quot; parent=&quot;1&quot; source=&quot;O1ju-O2xqUf5AKu2T8ts-2&quot; target=&quot;O1ju-O2xqUf5AKu2T8ts-5&quot;&gt;&#10;          &lt;mxGeometry relative=&quot;1&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;O1ju-O2xqUf5AKu2T8ts-9&quot; value=&quot;&amp;lt;div&amp;gt;求解（两块同管线）：&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;① 频域黄金：2×2 复阻抗 → P̄=½cω²|相对复幅值|²（精确稳态主值）&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;② 零初值 DOP853 40T（rtol 1e-9, max_step=T/200）→ 733 点导出&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;③ 相量初值核验（vs 解析稳态 1e-13）+ 独立 RK4 增广双解法（1e-6/1e-4）&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;④ 零初值稳态可达性：逐周期积分 ≤400 周期，双判据 1e-7（垂荡 97 周期 / 纵摇 197 周期收敛，vs 频域 1e-8）&amp;lt;/div&amp;gt;&quot; style=&quot;rounded=0;whiteSpace=wrap;html=1;&quot; vertex=&quot;1&quot; parent=&quot;1&quot;&gt;&#10;          &lt;mxGeometry x=&quot;40&quot; y=&quot;520&quot; width=&quot;630&quot; height=&quot;150&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;O1ju-O2xqUf5AKu2T8ts-10&quot; style=&quot;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.229;entryY=0.003;entryDx=0;entryDy=0;entryPerimeter=0;&quot; edge=&quot;1&quot; parent=&quot;1&quot; source=&quot;O1ju-O2xqUf5AKu2T8ts-4&quot; target=&quot;O1ju-O2xqUf5AKu2T8ts-9&quot;&gt;&#10;          &lt;mxGeometry relative=&quot;1&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;O1ju-O2xqUf5AKu2T8ts-11&quot; style=&quot;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.771;entryY=-0.007;entryDx=0;entryDy=0;entryPerimeter=0;&quot; edge=&quot;1&quot; parent=&quot;1&quot; source=&quot;O1ju-O2xqUf5AKu2T8ts-5&quot; target=&quot;O1ju-O2xqUf5AKu2T8ts-9&quot;&gt;&#10;          &lt;mxGeometry relative=&quot;1&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;O1ju-O2xqUf5AKu2T8ts-14&quot; value=&quot;&amp;lt;div&amp;gt;稳态口径：频域精确值为主值&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;P̄_z = 41.8416 W&amp;amp;nbsp;&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;P̄_θ = 1.4675×10⁻³ W&amp;lt;/div&amp;gt;&quot; style=&quot;rounded=0;whiteSpace=wrap;html=1;&quot; vertex=&quot;1&quot; parent=&quot;1&quot;&gt;&#10;          &lt;mxGeometry x=&quot;40&quot; y=&quot;720&quot; width=&quot;290&quot; height=&quot;80&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;O1ju-O2xqUf5AKu2T8ts-15&quot; value=&quot;&amp;lt;div&amp;gt;&amp;amp;nbsp;报告制：40T 窗口含慢模态拍频&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;amp;nbsp;瞬态（+0.63%），窗口值仅作对照；&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;&amp;amp;nbsp;纵摇慢模态 τ≈45 s 未完全周期化&amp;amp;nbsp;&amp;lt;/div&amp;gt;&quot; style=&quot;rounded=0;whiteSpace=wrap;html=1;&quot; vertex=&quot;1&quot; parent=&quot;1&quot;&gt;&#10;          &lt;mxGeometry x=&quot;380&quot; y=&quot;720&quot; width=&quot;290&quot; height=&quot;80&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;O1ju-O2xqUf5AKu2T8ts-25&quot; style=&quot;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;&quot; edge=&quot;1&quot; parent=&quot;1&quot; source=&quot;O1ju-O2xqUf5AKu2T8ts-17&quot; target=&quot;O1ju-O2xqUf5AKu2T8ts-18&quot;&gt;&#10;          &lt;mxGeometry relative=&quot;1&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;O1ju-O2xqUf5AKu2T8ts-17&quot; value=&quot;&amp;lt;div&amp;gt;验证（失败-回退表，全绿）：退化解→Q1 / M/C/K 正定 / 能量守恒&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;角度&amp;amp;lt;0.1 rad / 加严积分对照≤1e-10 / J_f ±20%敏感性&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;预判量级对照（P_z 40-50 W、P_θ 1.5e-3 W、|α| 0.043 rad 三连命中）&amp;lt;/div&amp;gt;&quot; style=&quot;rounded=0;whiteSpace=wrap;html=1;&quot; vertex=&quot;1&quot; parent=&quot;1&quot;&gt;&#10;          &lt;mxGeometry x=&quot;40&quot; y=&quot;840&quot; width=&quot;630&quot; height=&quot;120&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;O1ju-O2xqUf5AKu2T8ts-18&quot; value=&quot;&amp;lt;div&amp;gt;&amp;amp;nbsp;输出：result3.xlsx&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;时刻表：10/20/40/60/100 s 八状态；P̄_z=41.8416 W, P̄_θ=1.47×10⁻³ W&amp;lt;/div&amp;gt;&amp;lt;div&amp;gt;max|α|=0.0726, max|β|=0.0742 rad（&amp;amp;lt;0.1）；总功率≈41.84 W&amp;lt;/div&amp;gt;&quot; style=&quot;rounded=0;whiteSpace=wrap;html=1;&quot; vertex=&quot;1&quot; parent=&quot;1&quot;&gt;&#10;          &lt;mxGeometry x=&quot;40&quot; y=&quot;1000&quot; width=&quot;630&quot; height=&quot;120&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;O1ju-O2xqUf5AKu2T8ts-20&quot; style=&quot;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.542;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;&quot; edge=&quot;1&quot; parent=&quot;1&quot; source=&quot;O1ju-O2xqUf5AKu2T8ts-9&quot; target=&quot;O1ju-O2xqUf5AKu2T8ts-14&quot;&gt;&#10;          &lt;mxGeometry relative=&quot;1&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;O1ju-O2xqUf5AKu2T8ts-21&quot; style=&quot;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.231;entryY=0.02;entryDx=0;entryDy=0;entryPerimeter=0;&quot; edge=&quot;1&quot; parent=&quot;1&quot; source=&quot;O1ju-O2xqUf5AKu2T8ts-14&quot; target=&quot;O1ju-O2xqUf5AKu2T8ts-17&quot;&gt;&#10;          &lt;mxGeometry relative=&quot;1&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;O1ju-O2xqUf5AKu2T8ts-23&quot; style=&quot;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.457;entryY=0.025;entryDx=0;entryDy=0;entryPerimeter=0;&quot; edge=&quot;1&quot; parent=&quot;1&quot; source=&quot;O1ju-O2xqUf5AKu2T8ts-9&quot; target=&quot;O1ju-O2xqUf5AKu2T8ts-15&quot;&gt;&#10;          &lt;mxGeometry relative=&quot;1&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;O1ju-O2xqUf5AKu2T8ts-24&quot; style=&quot;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.771;entryY=0.006;entryDx=0;entryDy=0;entryPerimeter=0;&quot; edge=&quot;1&quot; parent=&quot;1&quot; source=&quot;O1ju-O2xqUf5AKu2T8ts-15&quot; target=&quot;O1ju-O2xqUf5AKu2T8ts-17&quot;&gt;&#10;          &lt;mxGeometry relative=&quot;1&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;      &lt;/root&gt;&#10;    &lt;/mxGraphModel&gt;&#10;  &lt;/diagram&gt;&#10;&lt;/mxfile&gt;&#10;"><defs/><g><g data-cell-id="0"><g data-cell-id="1"><g data-cell-id="O1ju-O2xqUf5AKu2T8ts-3"><g><path d="M 315 80 L 315 123.63" fill="none" stroke="rgb(0, 0, 0)" stroke-miterlimit="10" pointer-events="stroke"/><path d="M 315 128.88 L 311.5 121.88 L 315 123.63 L 318.5 121.88 Z" fill="rgb(0, 0, 0)" stroke="rgb(0, 0, 0)" stroke-miterlimit="10" pointer-events="all"/></g></g><g data-cell-id="O1ju-O2xqUf5AKu2T8ts-1"><g><rect x="0" y="0" width="630" height="80" fill="rgb(255, 255, 255)" stroke="rgb(0, 0, 0)" pointer-events="all"/></g><g><g transform="translate(-0.5 -0.5)scale(0.9999999999999999)"><switch><foreignObject pointer-events="none" width="101%" height="101%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; text-align: left;"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 628px; height: 1px; padding-top: 40px; margin-left: 1px;"><div data-drawio-colors="color: rgb(0, 0, 0); " style="box-sizing: border-box; font-size: 0px; text-align: center;"><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: rgb(0, 0, 0); line-height: 1.2; pointer-events: all; white-space: normal; overflow-wrap: normal;"><div> 输入：题面 ω=1.7152, c_z=10000, c_θ=1000 + 附件3 问题3 行</div><div>（a_z,a_θ,b_z,b_θ,f,L）+ 附件4 + P1 k_h + P5 派生(J_f,J_o,s₀,K_g)</div></div></div></div></foreignObject><text x="315" y="44" fill="rgb(0, 0, 0)" font-family="&quot;Helvetica&quot;" font-size="12px" text-anchor="middle">输入：题面 ω=1.7152, c_z=10000, c_θ=1000 + 附件3 问题3 行...</text></switch></g></g></g><g data-cell-id="O1ju-O2xqUf5AKu2T8ts-2"><g><rect x="0" y="130" width="630" height="110" fill="rgb(255, 255, 255)" stroke="rgb(0, 0, 0)" pointer-events="all"/></g><g><g transform="translate(-0.5 -0.5)scale(0.9999999999999999)"><switch><foreignObject pointer-events="none" width="101%" height="101%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; text-align: left;"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 628px; height: 1px; padding-top: 185px; margin-left: 1px;"><div data-drawio-colors="color: rgb(0, 0, 0); " style="box-sizing: border-box; font-size: 0px; text-align: center;"><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: rgb(0, 0, 0); line-height: 1.2; pointer-events: all; white-space: normal; overflow-wrap: normal;"><div>双块一阶解耦论证：直线 PTO 力沿中轴对铰点无力矩（r×F 沿轴叉积为零）+ </div><div>小角度一阶近似（振子滑动对惯量变化为二阶项）</div><div>升级触发器：max(|α|,|β|) &gt; 0.1 rad → 完整几何模型</div></div></div></div></foreignObject><text x="315" y="189" fill="rgb(0, 0, 0)" font-family="&quot;Helvetica&quot;" font-size="12px" text-anchor="middle">双块一阶解耦论证：直线 PTO 力沿中轴对铰点无力矩（r×F 沿轴叉积为零）+...</text></switch></g></g></g><g data-cell-id="O1ju-O2xqUf5AKu2T8ts-4"><g><rect x="0" y="290" width="290" height="120" fill="rgb(255, 255, 255)" stroke="rgb(0, 0, 0)" pointer-events="all"/></g><g><g transform="translate(-0.5 -0.5)scale(0.9999999999999999)"><switch><foreignObject pointer-events="none" width="101%" height="101%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; text-align: left;"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 288px; height: 1px; padding-top: 350px; margin-left: 1px;"><div data-drawio-colors="color: rgb(0, 0, 0); " style="box-sizing: border-box; font-size: 0px; text-align: center;"><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: rgb(0, 0, 0); line-height: 1.2; pointer-events: all; white-space: normal; overflow-wrap: normal;"><div> 垂荡块 (z_f, z_o) 2×2 线性系统</div><div>M_z q̈+C_z q̇+K_z q=[f cosωt,0]</div><div>C_z=[[b_z+c_z,−c_z],[−c_z,c_z]]</div><div>K_z=[[k_h+k_spr,−k_spr],[−k_spr,k_spr]]</div></div></div></div></foreignObject><text x="145" y="354" fill="rgb(0, 0, 0)" font-family="&quot;Helvetica&quot;" font-size="12px" text-anchor="middle">垂荡块 (z_f, z_o) 2×2 线性系统...</text></switch></g></g></g><g data-cell-id="O1ju-O2xqUf5AKu2T8ts-5"><g><rect x="340" y="290" width="290" height="120" fill="rgb(255, 255, 255)" stroke="rgb(0, 0, 0)" pointer-events="all"/></g><g><g transform="translate(-0.5 -0.5)scale(0.9999999999999999)"><switch><foreignObject pointer-events="none" width="101%" height="101%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; text-align: left;"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 288px; height: 1px; padding-top: 350px; margin-left: 341px;"><div data-drawio-colors="color: rgb(0, 0, 0); " style="box-sizing: border-box; font-size: 0px; text-align: center;"><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: rgb(0, 0, 0); line-height: 1.2; pointer-events: all; white-space: normal; overflow-wrap: normal;"><div>纵摇块 (α, β) 2×2 线性系统</div><div>M_θ q̈+C_θ q̇+K_θ q=[L cosωt,0]</div><div>K_θ=[[K_α+k_θ,−k_θ], [−k_θ, k_θ−K_g]]（K_g 负刚度）</div></div></div></div></foreignObject><text x="485" y="354" fill="rgb(0, 0, 0)" font-family="&quot;Helvetica&quot;" font-size="12px" text-anchor="middle">纵摇块 (α, β) 2×2 线性系统...</text></switch></g></g></g><g data-cell-id="O1ju-O2xqUf5AKu2T8ts-7"><g><path d="M 157.5 240 L 157.53 265 L 157.04 285.67" fill="none" stroke="rgb(0, 0, 0)" stroke-miterlimit="10" pointer-events="stroke"/><path d="M 156.92 290.92 L 153.58 283.84 L 157.04 285.67 L 160.58 284.01 Z" fill="rgb(0, 0, 0)" stroke="rgb(0, 0, 0)" stroke-miterlimit="10" pointer-events="all"/></g></g><g data-cell-id="O1ju-O2xqUf5AKu2T8ts-8"><g><path d="M 472.5 240 L 472.47 265 L 472.94 283.15" fill="none" stroke="rgb(0, 0, 0)" stroke-miterlimit="10" pointer-events="stroke"/><path d="M 473.08 288.4 L 469.4 281.5 L 472.94 283.15 L 476.4 281.31 Z" fill="rgb(0, 0, 0)" stroke="rgb(0, 0, 0)" stroke-miterlimit="10" pointer-events="all"/></g></g><g data-cell-id="O1ju-O2xqUf5AKu2T8ts-9"><g><rect x="0" y="490" width="630" height="150" fill="rgb(255, 255, 255)" stroke="rgb(0, 0, 0)" pointer-events="all"/></g><g><g transform="translate(-0.5 -0.5)scale(0.9999999999999999)"><switch><foreignObject pointer-events="none" width="101%" height="101%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; text-align: left;"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 628px; height: 1px; padding-top: 565px; margin-left: 1px;"><div data-drawio-colors="color: rgb(0, 0, 0); " style="box-sizing: border-box; font-size: 0px; text-align: center;"><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: rgb(0, 0, 0); line-height: 1.2; pointer-events: all; white-space: normal; overflow-wrap: normal;"><div>求解（两块同管线）：</div><div>① 频域黄金：2×2 复阻抗 → P̄=½cω²|相对复幅值|²（精确稳态主值）</div><div>② 零初值 DOP853 40T（rtol 1e-9, max_step=T/200）→ 733 点导出</div><div>③ 相量初值核验（vs 解析稳态 1e-13）+ 独立 RK4 增广双解法（1e-6/1e-4）</div><div>④ 零初值稳态可达性：逐周期积分 ≤400 周期，双判据 1e-7（垂荡 97 周期 / 纵摇 197 周期收敛，vs 频域 1e-8）</div></div></div></div></foreignObject><text x="315" y="569" fill="rgb(0, 0, 0)" font-family="&quot;Helvetica&quot;" font-size="12px" text-anchor="middle">求解（两块同管线）：① 频域黄金：2×2 复阻抗 → P̄=½cω²|相对复幅值|²（精确稳态主值）...</text></switch></g></g></g><g data-cell-id="O1ju-O2xqUf5AKu2T8ts-10"><g><path d="M 145 410 L 145 450.05 L 144.39 484.08" fill="none" stroke="rgb(0, 0, 0)" stroke-miterlimit="10" pointer-events="stroke"/><path d="M 144.29 489.33 L 140.92 482.27 L 144.39 484.08 L 147.92 482.4 Z" fill="rgb(0, 0, 0)" stroke="rgb(0, 0, 0)" stroke-miterlimit="10" pointer-events="all"/></g></g><g data-cell-id="O1ju-O2xqUf5AKu2T8ts-11"><g><path d="M 485 410 L 485 450.05 L 485.61 482.58" fill="none" stroke="rgb(0, 0, 0)" stroke-miterlimit="10" pointer-events="stroke"/><path d="M 485.71 487.83 L 482.08 480.9 L 485.61 482.58 L 489.08 480.77 Z" fill="rgb(0, 0, 0)" stroke="rgb(0, 0, 0)" stroke-miterlimit="10" pointer-events="all"/></g></g><g data-cell-id="O1ju-O2xqUf5AKu2T8ts-14"><g><rect x="0" y="690" width="290" height="80" fill="rgb(255, 255, 255)" stroke="rgb(0, 0, 0)" pointer-events="all"/></g><g><g transform="translate(-0.5 -0.5)scale(0.9999999999999999)"><switch><foreignObject pointer-events="none" width="101%" height="101%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; text-align: left;"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: uns