<mxfile host="www.iodraw.com" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/151.0.0.0 Safari/537.36 Edg/151.0.0.0" version="24.7.17">
  <diagram name="第 1 页" id="McvMyDJYeai2nbM1TonE">
    <mxGraphModel dx="681" dy="645" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="1Og1Sy4L1hmdW7rZDvrz-11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1Og1Sy4L1hmdW7rZDvrz-1" target="1Og1Sy4L1hmdW7rZDvrz-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="1Og1Sy4L1hmdW7rZDvrz-1" value="&lt;div&gt;题面 ω=1.9806, c_z/c_θ∈[0,100000] + 附件3 问题4 行&lt;/div&gt;&lt;div&gt;a_z=1091.099,a_θ=7142.493,b_z=528.5018,b_θ=1655.909,f=1760,L=2140）+ 附件4 + P1 k_h + P5 派生(J_f,J_o,s₀,K_g)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="40" width="440" height="70" as="geometry" />
        </mxCell>
        <mxCell id="1Og1Sy4L1hmdW7rZDvrz-2" value="&lt;div&gt;优化问题陈述：max P̄(c_z,c_θ) s.t. 0≤c_z,c_θ≤100000&lt;/div&gt;&lt;div&gt;目标口径：PTO 平均输出功率（题面无显式公式，物理口径交代）&lt;/div&gt;&lt;div&gt;P̄ = ½c_z·ω²|Z_o−Z_f|² + ½c_θ·ω²|B−A|²（P4 双块解耦，各自 2×2 频域解）&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="150" width="440" height="70" as="geometry" />
        </mxCell>
        <mxCell id="1Og1Sy4L1hmdW7rZDvrz-3" value="&lt;div&gt;垂荡块 1D 频域优化 P̄_z(c_z)&amp;nbsp;&lt;/div&gt;&lt;div&gt;200 点对数扫描 + 单峰性&lt;/div&gt;&lt;div&gt;端点复核 + 精化→ c_z*_1d = 59152.91&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="260" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="1Og1Sy4L1hmdW7rZDvrz-4" value="&lt;div&gt;纵摇块 1D 频域优化 P̄_θ(c_θ)同结构；&lt;/div&gt;&lt;div&gt;单调上升 → 顶界候选 → c_θ*_1d → 100000（顶界）&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="260" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="1Og1Sy4L1hmdW7rZDvrz-16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="1Og1Sy4L1hmdW7rZDvrz-5" target="1Og1Sy4L1hmdW7rZDvrz-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="1Og1Sy4L1hmdW7rZDvrz-5" value="&lt;div&gt;二维确定性粗网格扫描：81×81=6561 点（对数轴，含 0 边界）&lt;/div&gt;&lt;div&gt;+ 可分离性验证（分解恒等 ~1e-16 + 脊结构 argmax 稳定） + 单峰性（两方向符号变化段 ≤1）&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="380" width="440" height="70" as="geometry" />
        </mxCell>
        <mxCell id="1Og1Sy4L1hmdW7rZDvrz-17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1Og1Sy4L1hmdW7rZDvrz-6" target="1Og1Sy4L1hmdW7rZDvrz-7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="1Og1Sy4L1hmdW7rZDvrz-6" value="&lt;div&gt;局部加密 + 边界复核：&lt;/div&gt;&lt;div&gt;① 粗扫 top-5 → Powell 有界精化（对数坐标，±1 网格步邻域）&lt;/div&gt;&lt;div&gt;② 四条边显式扫描（各 200 点 + 精化）+ 四个角点显式求值（P(0,0)=0）&amp;nbsp; &amp;nbsp;&lt;/div&gt;&lt;div&gt;③ 边界最优判定：c_θ=1e5 边内最优 318.4464 ≥ 内部精化 318.4463→ c_θ* = 100000（顶界，约束域内最优候选）&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="500" width="440" height="100" as="geometry" />
        </mxCell>
