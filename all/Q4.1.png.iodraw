93.63 L 223.5 591.88 Z" fill="rgb(0, 0, 0)" stroke="rgb(0, 0, 0)" stroke-miterlimit="10" pointer-events="all"/></g></g><g data-cell-id="1Og1Sy4L1hmdW7rZDvrz-6"><g><rect x="0" y="460" width="440" height="100" fill="rgb(255, 255, 255)" stroke="rgb(0, 0, 0)" pointer-events="all"/></g><g><g transform="translate(-0.5 -0.5)"><switch><foreignObject pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; text-align: left;"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 438px; height: 1px; padding-top: 510px; margin-left: 1px;"><div data-drawio-colors="color: rgb(0, 0, 0); " style="box-sizing: border-box; font-size: 0px; text-align: center;"><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: rgb(0, 0, 0); line-height: 1.2; pointer-events: all; white-space: normal; overflow-wrap: normal;"><div>局部加密 + 边界复核：</div><div>① 粗扫 top-5 → Powell 有界精化（对数坐标，±1 网格步邻域）</div><div>② 四条边显式扫描（各 200 点 + 精化）+ 四个角点显式求值（P(0,0)=0）   </div><div>③ 边界最优判定：c_θ=1e5 边内最优 318.4464 ≥ 内部精化 318.4463→ c_θ* = 100000（顶界，约束域内最优候选）</div></div></div></div></foreignObject><text x="220" y="514" fill="rgb(0, 0, 0)" font-family="&quot;Helvetica&quot;" font-size="12px" text-anchor="middle">局部加密 + 边界复核：...</text></switch></g></g></g><g data-cell-id="1Og1Sy4L1hmdW7rZDvrz-18"><g><path d="M 220 700 L 220 733.63" fill="none" stroke="rgb(0, 0, 0)" stroke-miterlimit="10" pointer-events="stroke"/><path d="M 220 738.88 L 216.5 731.88 L 220 733.63 L 223.5 731.88 Z" fill="rgb(0, 0, 0)" stroke="rgb(0, 0, 0)" stroke-miterlimit="10" pointer-events="all"/></g></g><g data-cell-id="1Og1Sy4L1hmdW7rZDvrz-7"><g><rect x="0" y="600" width="440" height="100" fill="rgb(255, 255, 255)" stroke="rgb(0, 0, 0)" pointer-events="all"/></g><g><g transform="translate(-0.5 -0.5)"><switch><foreignObject pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; text-align: left;"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 438px; height: 1px; padding-top: 650px; margin-left: 1px;"><div data-drawio-colors="color: rgb(0, 0, 0); " style="box-sizing: border-box; font-size: 0px; text-align: center;"><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: rgb(0, 0, 0); line-height: 1.2; pointer-events: all; white-space: normal; overflow-wrap: normal;"><div>时域定案（零初值独立验证）：</div><div>① 稳态可达性：逐周期 DOP853 ≤400 周期，双判据 1e-7，末 10 周期均值(heave 104 周期 / pitch 89 周期收敛，vs 频域 6.4e-7/2.9e-9）</div><div>② 双解法：相量初值核验（1e-13）+ 独立 RK4 增广（1e-4 级）</div><div>③ c_z 方向时域五点 ×{0.8..1.2} → c_z*_td = 59152.05（rel 0.0015%）</div></div></div></div></foreignObject><text x="220" y="654" fill="rgb(0, 0, 0)" font-family="&quot;Helvetica&quot;" font-size="12px" text-anchor="middle">时域定案（零初值独立验证）：① 稳态可达性：逐周期 DOP853 ≤400 周期，双判据 1e-7，末 10 周期均值(heave 104 周期 / pitch 89 周期收敛，vs 频域 6.4e-7/2.9e-9）...</text></switch></g></g></g><g data-cell-id="1Og1Sy4L1hmdW7rZDvrz-19"><g><path d="M 220 840 L 220 873.63" fill="none" stroke="rgb(0, 0, 0)" stroke-miterlimit="10" pointer-events="stroke"/><path d="M 220 878.88 L 216.5 871.88 L 220 873.63 L 223.5 871.88 Z" fill="rgb(0, 0, 0)" stroke="rgb(0, 0, 0)" stroke-miterlimit="10" pointer-events="all"/></g></g><g data-cell-id="1Og1Sy4L1hmdW7rZDvrz-8"><g><rect x="0" y="740" width="440" height="100" fill="rgb(255, 255, 255)" stroke="rgb(0, 0, 0)" pointer-events="all"/></g><g><g transform="translate(-0.5 -0.5)"><switch><foreignObject pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; text-align: left;"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 438px; height: 1px; pa