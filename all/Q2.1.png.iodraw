        <mxCell id="JYbCVB8NJNtR27vUfzgu-6" value="&lt;div&gt;频域精确解 P̄_fd(c)=½c·ω²|Z_o−Z_f|²&lt;/div&gt;&lt;div&gt;对数网格 200 点粗扫 → 单峰性检查&lt;/div&gt;&lt;div&gt;→ 端点复核(c=0, 1e5)&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp;→ minimize_scalar(xatol=1e-8) 精化&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="10" y="350" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="JYbCVB8NJNtR27vUfzgu-7" value="&lt;div&gt;打靶法：单周期映射 Newton 求周期不动点&lt;/div&gt;&lt;div&gt;F(x)=advance(x)−x=0（hybr, factor=0.1）&lt;/div&gt;&lt;div&gt;初值=延续终态或频域相量解（失败相量重试）&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
